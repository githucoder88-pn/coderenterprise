{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "paths": {
      "@/*": ["./renderer/*"],
      "@electron/*": ["./electron/*"]
    },
    "baseUrl": "."
  },
  "include": ["electron/**/*.ts", "electron/**/*.tsx", "renderer/**/*.ts", "renderer/**/*.tsx"],
  "exclude": ["node_modules", "dist", "dist-electron", "**/*.test.ts"]
}
